{
	"name": "debug-for-file",
	"version": "0.5.0",
	"description": "debug() wrapper that creates a string based on your file's path within the package. 🧶",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JoshuaKGoldberg/debug-for-file.git"
	},
	"license": "MIT",
	"author": {
		"name": "Josh Goldberg ✨",
		"email": "npm@joshuakgoldberg.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"browser": "./dist/browser.js",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"browser": "./dist/browser.js",
	"files": [
		"dist/"
	],
	"scripts": {
		"build": "tsdown",
		"format": "prettier .",
		"lint": "eslint . --max-warnings 0",
		"lint:knip": "knip",
		"lint:knip:production": "knip --production",
		"lint:packages": "pnpm dedupe --check",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"prepare": "husky",
		"test": "vitest",
		"tsc": "tsc"
	},
	"dependencies": {
		"@types/debug": "^4.1.12",
		"debug": "^4.4.3"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@eslint/js": "10.0.1",
		"@eslint/markdown": "9.0.0",
		"@release-it/conventional-changelog": "12.0.0",
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "5.1.0",
		"@vitest/eslint-plugin": "1.6.27",
		"console-fail-test": "0.10.0",
		"create-typescript-app": "2.87.9",
		"cspell": "10.5.2",
		"eslint": "10.15.0",
		"eslint-plugin-jsdoc": "65.5.0",
		"eslint-plugin-jsonc": "3.4.1",
		"eslint-plugin-markdown-links": "0.9.1",
		"eslint-plugin-n": "18.5.0",
		"eslint-plugin-package-json": "1.14.0",
		"eslint-plugin-perfectionist": "5.14.0",
		"eslint-plugin-regexp": "3.3.1",
		"eslint-plugin-yml": "3.10.0",
		"husky": "9.1.7",
		"jiti": "2.7.0",
		"knip": "6.47.0",
		"prettier": "3.10.0",
		"prettier-plugin-curly": "0.4.1",
		"prettier-plugin-packagejson": "3.1.0",
		"prettier-plugin-padding-lines": "0.1.0",
		"prettier-plugin-sentences-per-line": "0.2.4",
		"prettier-plugin-sh": "0.20.0",
		"pretty-quick": "4.2.2",
		"release-it": "21.1.0",
		"tsdown": "0.23.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.73.0",
		"vitest": "5.1.0"
	},
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": ">=22.14.0"
	},
	"publishConfig": {
		"provenance": true
	}
}
